# Caracal configuration — copy to .env and replace the change-me placeholders.
# Every variable is documented in docs/02-configuration.md.

# --- server ---
CARACAL_HOST=127.0.0.1
CARACAL_PORT=11404
CARACAL_API_TOKEN=change-me-change-me-change-me-1234
CARACAL_PUBLIC_BASE_URL=http://127.0.0.1:11404
CARACAL_ALLOWED_HOSTS=
CARACAL_DATA_DIR=./data
CARACAL_RETENTION_DAYS=30
CARACAL_KEEP_MEDIA=false

# --- datastores (required) ---
DATABASE_URL=postgresql+psycopg://caracal:change-me@latitude:5432/caracal
CARACAL_DB_SCHEMA=public
REDIS_URL=redis://:change-me@latitude:6379/0
REDIS_PREFIX=caracal:

# --- whisper.cpp ---
WHISPER_URL=http://localhost:8768
WHISPER_TIMEOUT_S=900

# --- LLM ---
OLLAMA_CLOUD_URL=https://ollama.com/api
OLLAMA_CLOUD_API_KEY=change-me
OLLAMA_LOCAL_URL=http://127.0.0.1:11434
LLM_MODEL=gemma4:31b
LLM_LOCAL_PROXY_MODEL=gemma4:31b-cloud
LLM_FALLBACK_MODEL=gemma4:31b
# Per-task routing. A ref is cloud:<name> (ollama.com + OLLAMA_CLOUD_API_KEY), local:<name>
# or a bare <name> (the local daemon, which proxies -cloud tags). Every ref a route uses must
# appear in LLM_ALLOWED_MODELS; a route's chain is tried in order until a model answers.
LLM_ALLOWED_MODELS=gemma4:31b-cloud,local:gemma4:31b
LLM_ROUTE_DEFAULT=gemma4:31b-cloud,local:gemma4:31b
# optional per task, e.g. LLM_ROUTE_QA=gemma4:31b-cloud
LLM_TIMEOUT_S=180
LLM_KEEP_ALIVE=30m
CARACAL_LLM_CONCURRENCY=4
LLM_CONTEXT_CHARS=60000

# --- diarization / voiceprints ---
HF_TOKEN=change-me
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
DIARIZATION_DEVICE=cuda
VOICEPRINT_MATCH_THRESHOLD=0.72
VOICEPRINT_CANDIDATE_THRESHOLD=0.55

# --- search ---
SEARCH_PROVIDERS=brave,exa
BRAVE_API_KEY=change-me
EXA_API_KEY=change-me
SEARCH_MAX_QUERIES_PER_JOB=24
SEARCH_CACHE_TTL_S=86400

# --- worker / limits ---
CARACAL_RATE_LIMIT_PER_MIN=30
CARACAL_WORKER_CONCURRENCY=2
CARACAL_JOB_TIMEOUT_S=10800
CARACAL_MAX_UPLOAD_MB=2048
CARACAL_MAX_DURATION_S=14400
CARACAL_REPORT_LANGUAGE=en
CARACAL_DEFAULT_TARGET_LANGS=en

# --- optional ---
YTDLP_COOKIES_FILE=
CARACAL_LOG_LEVEL=INFO

[Unit]
StartLimitIntervalSec=0
Description=Caracal pipeline worker (Redis Streams consumer, daily retention)
Documentation=file:///home/sameer/Public/Shared/Work/Services/MCP/Caracal/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sameer
Group=sameer
WorkingDirectory=/home/sameer/Public/Shared/Work/Services/MCP/Caracal
EnvironmentFile=/home/sameer/Public/Shared/Work/Services/MCP/Caracal/.env
# pyannote imports matplotlib, whose default config dir (~/.config/matplotlib) is read-only under ProtectHome.
Environment=MPLCONFIGDIR=/home/sameer/Public/Shared/Work/Services/MCP/Caracal/data/.matplotlib
ExecStart=/home/sameer/Public/Shared/Work/Services/MCP/Caracal/.venv/bin/caracal worker
Restart=always
RestartSec=5
TimeoutStopSec=60
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/sameer/Public/Shared/Work/Services/MCP/Caracal/data
# pyannote/huggingface_hub writes refs + lock files even for cached models; torch and yt-dlp keep caches too.
# Without these, ProtectHome=read-only would break diarization and YouTube downloads under the system manager.
ReadWritePaths=/home/sameer/.cache/huggingface /home/sameer/.cache/torch /home/sameer/.cache/yt-dlp
PrivateTmp=true
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
